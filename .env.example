# Copy this file to .env and add local values.
# Never commit the real .env file.

ANTHROPIC_API_KEY=
OPENCLAW_GATEWAY_TOKEN=

# --- GovDelivery email-subscription connector (source: govdelivery_email) ---
# Only the *_HOST, *_USER, and *_PASSWORD are required for the connector to
# report OK. Leave everything blank until you've subscribed to at least one
# WA DES GovDelivery topic (see docs/data-sources.md).
#
# For Gmail/Google Workspace, generate an App Password (2FA required):
#   https://myaccount.google.com/apppasswords
# Never use your primary account password.

GCO_GOVDELIVERY_IMAP_HOST=
GCO_GOVDELIVERY_IMAP_PORT=993
GCO_GOVDELIVERY_IMAP_USER=
GCO_GOVDELIVERY_IMAP_PASSWORD=
GCO_GOVDELIVERY_IMAP_MAILBOX=INBOX
GCO_GOVDELIVERY_LOOKBACK_DAYS=30
