# data & secrets
/data/
.env
.env.*
!.env.example
*.key
*.pem

# Live organization profiles (only the *.example.yaml is committed; the real
# profile-of-record stays local to avoid leaking EIN / registration numbers /
# board attestations. See SECURITY.md and organizations/nonprofit/README.md.)
organizations/*/organization-profile.yaml
!organizations/*/organization-profile.example.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# gov-contract-os runtime state (SQLite db, local OpenClaw state)
/runtime/

# browser automation research artifacts
.playwright-mcp/

# Node
node_modules/
dist/
build/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
